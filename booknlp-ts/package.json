{
    "name": "booknlp-ts",
    "version": "1.0.3",
    "description": "TypeScript port of entity, event, and supersense extraction pipelines of BookNLP (spaCy extraction excluded)",
    "type": "module",
    "main": "./dist/booknlp.umd.cjs",
    "module": "./dist/booknlp.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/booknlp.js",
            "require": "./dist/booknlp.umd.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "public"
    ],
    "license": "MIT",
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite build --watch",
        "lint": "eslint src/**/*.ts"
    },
    "dependencies": {
        "@huggingface/transformers": "^3.8.1",
        "onnxruntime-web": "^1.16.0"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.0.0",
        "typescript": "^5.0.0",
        "vite": "^5.0.0",
        "vite-plugin-dts": "^3.0.0"
    },
    "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
